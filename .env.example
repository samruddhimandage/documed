# DocuMed — local environment template
# Copy to `.env` and fill in the values. Never commit `.env`.

# ---- Client (browser, publishable) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key_here
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# ---- Server (SSR + TanStack server functions) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_key_here
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Secret — required for user registration (admin.createUser).
# Lovable Cloud does NOT expose this; create your own Supabase project to obtain it.
# Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
